local function startVoiceTyping(langCode)
    local editText = service.getEditText()
    if not editText then service.speak("No text field focused"); showMainDialog(); return end
    local context = service.getApplicationContext()
    local speechRec = SpeechRecognizer.createSpeechRecognizer(context)
    local listener = RecognitionListener {
        onResults = function(results)
            local arr = results.getParcelableArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
            if arr and arr.size()>0 then
                local text = arr.get(0)
                for wrong,correct in pairs(changeTable) do
                    text = text:gsub(wrong, correct)
                end
                text = text:gsub("%s([?,!])", "%1")
                if not text:match("[.?!,.]$") then text = text..". " end
                local aiKeyOpen = getOpenRouterApiKey()
                local aiKeyGroq = getGroqApiKey()
                if (getAIProvider()=="openrouter" and aiKeyOpen~="") or (getAIProvider()=="groq" and aiKeyGroq~="") then
                    service.speak("AI processing...")
                    processWithAI(text, function(enhanced)
                        service.insertText(editText, enhanced)
                        service.speak(enhanced)
                        speechRec.destroy()
                    end)
                else
                    service.insertText(editText, text)
                    service.speak(text)
                    speechRec.destroy()
                end
            else speechRec.destroy() end
        end,
        onError = function(err) service.asyncSpeak("Did not understand"); speechRec.destroy(); return false end
    }
    local intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
    intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
    intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, langCode)
    speechRec.setRecognitionListener(listener)
    speechRec.startListening(intent)
end

