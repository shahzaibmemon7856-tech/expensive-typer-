local function testOpenRouterAPI(apiKey, model, callback)
    Http.get("https://openrouter.ai/api/v1/auth/key", {["Authorization"]="Bearer "..apiKey}, function(status, data)
        if status==200 then callback(true,"Valid") else callback(false,"Invalid or error") end
    end)
end
local function testGroqAPI(apiKey, model, callback)
    Http.get("https://api.groq.com/openai/v1/models", {["Authorization"]="Bearer "..apiKey}, function(status, data)
        if status==200 then callback(true,"Valid") else callback(false,"Invalid or error") end
    end)
end

local function callOpenRouterAPI(apiKey, model, prompt, callback)
    local payload = {
        model = model,
        messages = {{role="user", content=prompt}},
        max_tokens = 1024,
        temperature = 0.7
    }
    Http.post("https://openrouter.ai/api/v1/chat/completions", cjson.encode(payload), {
        ["Content-Type"]="application/json",
        ["Authorization"]="Bearer "..apiKey,
        ["HTTP-Referer"]="https://github.com/SmartTechSabir",
        ["X-Title"]="Expensive Typer"
    }, function(status, data)
        if status==200 then
            local ok,res = pcall(cjson.decode, data)
            if ok and res and res.choices then callback(res.choices[1].message.content, nil)
            else callback(nil, "Parse error") end
        else callback(nil, "HTTP "..tostring(status)) end
    end)
end

local function callGroqAPI(apiKey, model, systemPrompt, userPrompt, callback)
    local messages = {}
    if systemPrompt and systemPrompt~="" then table.insert(messages, {role="system", content=systemPrompt}) end
    table.insert(messages, {role="user", content=userPrompt})
    local payload = {model=model, messages=messages, max_tokens=1024, temperature=0.7}
    Http.post("https://api.groq.com/openai/v1/chat/completions", cjson.encode(payload), {
        ["Content-Type"]="application/json",
        ["Authorization"]="Bearer "..apiKey
    }, function(status, data)
        if status==200 then
            local ok,res = pcall(cjson.decode, data)
            if ok and res and res.choices then callback(res.choices[1].message.content, nil)
            else callback(nil, "Parse error") end
        else callback(nil, "HTTP "..tostring(status)) end
    end)
end

local function processWithAI(spokenText, callback)
    local provider = getAIProvider()
    if provider == "openrouter" then
        local apiKey = getOpenRouterApiKey()
        if apiKey == "" then service.speak("Set OpenRouter API key in AI Settings"); callback(spokenText); return end
        local model = getOpenRouterModel()
        local translation = isTranslationEnabled()
        local emoji = isEmojiEnabled()
        local prompt
        if translation then
            prompt = "Fix spelling mistakes (Urdu/English), add punctuation. Translate entire text to "..getTargetLanguageName()..". No emojis. Return only translated text.\nText: "..spokenText
        elseif emoji then
            prompt = "Fix spelling mistakes, add punctuation. After each sentence add ONE relevant emoji. Return only text with emojis.\nText: "..spokenText
        else
            prompt = "Fix spelling mistakes, add punctuation. No emojis. Return only corrected text.\nText: "..spokenText
        end
        callOpenRouterAPI(apiKey, model, prompt, callback)
    else
        local apiKey = getGroqApiKey()
        if apiKey == "" then service.speak("Set Groq API key in AI Settings"); callback(spokenText); return end
        local model = getGroqModel()
        local mode = getGroqMode()
        local systemPrompt = ""
        if mode == "conversion" then
            systemPrompt = [[Task: Convert Urdu/Hindi text to Mixed Script. Keep grammar and sentence structure. Convert only proper nouns, technical terms, and common English loanwords to English spelling. Return only converted text.
Example: میرا نام ثابر جمیل ہے۔ -> میرا نام Sabir Jamil ہے۔]]
        else
            systemPrompt = [[Task: Enhance text to be professional, articulate, engaging. Correct grammar, improve vocabulary, refine tone. Preserve meaning. Return only enhanced version.
Example: میں کل کام پر نہیں آؤں گا۔ -> معذرت چاہتا ہوں، میں کچھ ناگزیر وجوہات کی بنا پر کل کام پر حاضر نہیں ہو سکوں گا۔]]
        end
        callGroqAPI(apiKey, model, systemPrompt, spokenText, callback)
    end
end

local dictFile = os.getenv("EXTERNAL_STORAGE") .. "/expensive_typer_dict.dat"
local langFile = os.getenv("EXTERNAL_STORAGE") .. "/expensive_typer_lang.dat"
local changeTable = {}

local function loadDictionary()
    local f = io.open(dictFile, "r")
    if f then
        local content = f:read("*all")
        f:close()
        if content and content~="" then
            local ok, res = pcall(cjson.decode, content)
            if ok then changeTable = res else changeTable = {} end
        end
    end
end
local function saveDictionary()
    local f = io.open(dictFile, "w")
    if f then f:write(cjson.encode(changeTable)) f:close() end
end
local function addToDictionary(wrong, correct)
    if wrong~="" and correct~="" then changeTable[wrong]=correct; saveDictionary(); return true end
    return false
end
local function getSavedLanguage()
    local f = io.open(langFile, "r")
    if f then local c = f:read("*all") f:close(); if c then return c:gsub("%s+","") end end
    return "ur-PK"
end
local function saveLanguage(code)
    local f = io.open(langFile, "w")
    if f then f:write(code) f:close(); service.speak("Language saved") end
end

